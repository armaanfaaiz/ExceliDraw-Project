# Root Environment Variables Template for ExceliDraw Monorepo

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/excelidraw?schema=public"

# JWT Secret for Auth & WebSocket tokens
JWT_SECRET="your-super-secret-jwt-key-here"

# HTTP API Backend URL
NEXT_PUBLIC_HTTP_BACKEND="http://localhost:3002"

# WebSocket Backend URL
NEXT_PUBLIC_WS_URL="ws://localhost:8080"

# Allowed CORS Origin
FRONTEND_URL="http://localhost:3000"
